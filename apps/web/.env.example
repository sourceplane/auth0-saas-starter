# Local configuration for `pnpm dev`. Copy to .env.local (never committed) —
# or let the tenant bootstrap write it for you, a tenant set up for
# http://localhost:3000 included: `pnpm auth0:bootstrap --local` from the
# repository root. A deployed environment never reads this file: its values
# are Orun secrets the bootstrap stores (`--env <env>`).

APP_BASE_URL=http://localhost:3000

# Global Auth0 SDK configuration
AUTH0_DOMAIN=
# Only for a tenant on a custom domain: the canonical domain for the Management API
AUTH0_MANAGEMENT_API_DOMAIN=
SESSION_ENCRYPTION_SECRET=

# Client ID and secret for the application within the context of an organization
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Client ID and secret for the application used to allow a user to manage organizations
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Roles assigned to the members of an organization
AUTH0_ADMIN_ROLE_ID=
AUTH0_MEMBER_ROLE_ID=

# The default connection ID users will use to create an account with during onboarding
DEFAULT_CONNECTION_ID=

# The namespace used to prefix custom claims
CUSTOM_CLAIMS_NAMESPACE=
